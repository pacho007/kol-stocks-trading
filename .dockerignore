# flyctl launch added from .gitignore
# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

**/node_modules
**/dist
**/dist-ssr
**/.output
**/.vinxi
**/.tanstack/**
**/.nitro
**/*.local

# Wrangler / Cloudflare
**/.wrangler
**/.dev.vars

# Editor directories and files
**/.vscode/*
!**/.vscode/extensions.json
**/.idea
**/.DS_Store
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Claude Code — settings.json is project-shared config and is committed;
# only the personal/machine-specific override file and runtime state are excluded.
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Environment-specific — see .env.example for the shape
**/.env

# Generated by oracle/publish.ts at runtime, not hand-maintained
**/public/scores.json

# Run logs from oracle/*.ts admin scripts — local record of one run, not source
**/oracle/.last-*.json

# Foundry (evm/) — forge-std is fetched via `forge install`, build output is
# regenerated by `forge build`. Neither belongs in source control.
**/evm/lib
**/evm/out
**/evm/cache
**/evm/.deployed

# flyctl launch added from evm/.gitignore
# Foundry build artifacts — regenerated by `forge build`/`forge test`, not source
evm/**/cache
evm/**/out

# Local env for deploy scripts (DEPLOYER_PRIVATE_KEY, etc.) — never commit
evm/**/.env

# flyctl launch added from evm/lib/forge-std/.gitignore
evm/lib/forge-std/**/cache
evm/lib/forge-std/**/out
evm/lib/forge-std/**/.vscode
evm/lib/forge-std/**/.idea
fly.toml
