# flyctl launch added from .gitignore
# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

**/node_modules
**/dist
**/dist-ssr
**/.output
**/.vinxi
**/.tanstack/**
**/.nitro
**/*.local

# Wrangler / Cloudflare
**/.wrangler
**/.dev.vars

# Editor directories and files
**/.vscode/*
!**/.vscode/extensions.json
**/.idea
**/.DS_Store
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Claude Code — settings.json is project-shared config and is committed;
# only the personal/machine-specific override file and runtime state are excluded.
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Environment-specific — see .env.example for the shape
**/.env

# Generated by oracle/publish.ts at runtime, not hand-maintained
**/public/scores.json

# Run logs from oracle/*.ts admin scripts — local record of one run, not source
**/oracle/.last-*.json

# Anchor build output and program keypair — not needed by the oracle image.
**/anchor/target
**/anchor/.anchor
**/anchor/node_modules
**/anchor/test-ledger

fly.toml

# The oracle stamps oracle/.launch on first run if LAUNCH_TS is unset. That
# file is written next to the source, so without this it is COPYed into the
# image and becomes a stale date baked into the container — one that would
# silently take over the moment the env var was missing. fly.toml sets
# LAUNCH_TS explicitly, so the file has no job in production.
oracle/.launch
