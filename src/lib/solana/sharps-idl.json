      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "listing",
            "type": "pubkey"
          },
          {
            "name": "shares",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PriceUpdated",
      "docs": [
        "Emitted on every oracle update AND every trade, since trades move the",
        "curve too — the price feed indexes this one event."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
