# Client-safe, public identifiers only — no secrets belong here.
# Defaults to devnet if unset (see src/lib/solana/connection.ts) so a
# missing env var can never silently point the app at mainnet.

VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=

# --- Shared market feed (Supabase) -------------------------------------------
# Both are PUBLIC, client-safe values. RLS (supabase/migrations/0001_market_state.sql)
# grants the anon key read-only access to market data and nothing else — it
# cannot write a price or forge a chart point.
#
# The SERVICE ROLE key is NOT listed here on purpose: it bypasses RLS entirely
# and belongs only in the indexer's server-side secrets (Supabase Edge Function
# config) and in your shell when running supabase/seed-listings.ts. It must
# never reach the browser or this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Robinhood Chain ---------------------------------------------------------
# Mainnet chain id 4663, testnet 46630. MARKET_ADDRESS is the deployed
# SharpsMarket contract (evm/src/SharpsMarket.sol).
VITE_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_MARKET_ADDRESS=
